# Desarrollo local: nunca subir .env.local a Git.
GAMEZONE_LOCAL_MODE=1
GAMEZONE_ADMIN_PASSWORD=
GAMEZONE_SESSION_SECRET=
# Ruta opcional para SQLite local; por defecto .data/gamezone.db.
GAMEZONE_DATABASE_PATH=

# Producción: desactivar modo local y configurar Supabase.
# Prepara las claves en .env.supabase.local y migra primero el catalogo.
# No actives una base remota vacia: dejaria de verse el catalogo local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# link usa la plantilla predeterminada; code requiere una plantilla con {{ .Token }}.
GAMEZONE_EDITOR_EMAIL_METHOD=link
# Cuentas de miembros: activar solo después de configurar Discord y aplicar SQL 004.
GAMEZONE_DISCORD_LOGIN_ENABLED=0
# Client ID y Client Secret de Discord se guardan en Supabase, no en este archivo.

# Enriquecimiento opcional, solo en servidor y con uso autorizado.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Origen exacto: en local utiliza 127.0.0.1 también en el navegador y la allowlist.
# En producción: https://tu-dominio.example (sin ruta ni parámetros).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_TELEMETRY_DISABLED=1
