# Copia a .env.supabase.local y rellena los valores solo en ese archivo privado.
# Esta preparacion NO activa Supabase en la web ni modifica .env.local.
# Project Settings > API Keys / Connect en el panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Origen exacto de GameZone; usar HTTPS en producción.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Mantener desactivado hasta aplicar SQL 004 y configurar el proveedor en Supabase.
GAMEZONE_DISCORD_LOGIN_ENABLED=0
# El Client ID y Client Secret de Discord se introducen en Supabase > Authentication.
# No son las claves públicas/secretas del proyecto y no se incluyen en este ejemplo.
